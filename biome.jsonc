{
	"$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/.astro/*",
			"!!**/.vscode/*",
			"!!**/.wrangler/*",
			"!!**/dist/*",
			"!**/public/*",
			"!**/worker-configuration.d.ts"
		]
	},
	"assist": {
		"enabled": true,
		"actions": {
			"preset": "recommended",
			"source": {
				"noDuplicateClasses": "on",
				"organizeImports": "on",
				"useSortedAttributes": "on",
				"useSortedEnumMembers": "on",
				"useSortedInterfaceMembers": "on",
				"useSortedPackageJson": "on",
				"useSortedProperties": "on"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"useEditorconfig": true
	},
	"linter": {
		"enabled": true,
		"domains": {
			"astro": "recommended",
			"project": "recommended",
			"types": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUndeclaredDependencies": "error"
			},
			"style": {
				"useImportType": "error"
			},
			"suspicious": {
				"noDeprecatedImports": "warn"
			},
			"nursery": {
				"noAstroComponentDefaultExport": "error",
				"noAstroConflictingSetDirectives": "error",
				"noAstroSetHtmlDirective": "error",
				"noUselessAssignment": "warn",
				"noUselessAwait": "warn",
				"noUselessNestedTernary": "info",
				"noUselessTypeAssertion": "warn",
				"noUselessTypeConversion": "info",
				"useAstroClientOnlyDirectiveValue": "error",
				"useAtomicUpdates": "info"
				// "useLogicalProperties": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded",
			"trailingCommas": "all"
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"enabled": true,
			"selfCloseVoidElements": "always"
		}
	},
	"markdown": {
		"analyzeEmbeds": true,
		"parser": {
			"frontmatter": true
		},
		"formatter": {
			"indentStyle": "space"
		}
	}
}
