{
	"$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
	},
	"files": {
		"includes": [
			"**",
			"!**/.astro/*",
			"!!**/.vscode/*",
			"!!**/.wrangler/*",
			"!!**/dist",
			"!**/public/*",
		],
	},
	"html": {
		"experimentalFullSupportEnabled": true,
	},
	"assist": {
		"enabled": false,
	},
	"formatter": {
		"enabled": false,
	},
	"linter": {
		"enabled": true,
		"domains": {
			"astro": "recommended",
			"project": "recommended",
			"types": "recommended",
		},
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUndeclaredDependencies": "error",
			},
			"suspicious": {
				"noDeprecatedImports": "warn",
			},
			"nursery": {
				"noAstroComponentDefaultExport": "error",
				"noAstroConflictingSetDirectives": "error",
				"noAstroSetHtmlDirective": "error",
				"noUselessAssignment": "warn",
				"noUselessAwait": "warn",
				"noUselessNestedTernary": "info",
				"noUselessTypeAssertion": "warn",
				"noUselessTypeConversion": "info",
				"useAstroClientOnlyDirectiveValue": "error",
				"useAtomicUpdates": "info",
			},
		},
	},
}
