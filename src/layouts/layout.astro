---
import '../styles/globals.scss'

import {
	UMAMI_ANALYTICS_HOST,
	UMAMI_ANALYTICS_ID,
	UMAMI_ANALYTICS_SCRIPT,
} from 'astro:env/client'

import type { HTMLAttributes } from 'astro/types'
import type { JsxChild } from 'typescript'
import iconSvg from '../assets/icon.svg'
import SocialIconSprite from '../assets/social-icon-sprite.svg'
import PageMeta, { type PageMetadata } from '../components/page-meta.astro'
import SiteFooter from '../components/site-footer.astro'
import SiteHeader from '../components/site-header.astro'
import siteMetadata from '../helpers/site-metadata.ts'

interface Props {
	children: JsxChild | JsxChild[]
	lang?: HTMLAttributes<'html'>['lang']
	meta?: PageMetadata
	title: string
}

const { title, meta, lang = 'en' } = Astro.props
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta
			content="width=device-width,initial-scale=1,viewport-fit=cover"
			name="viewport"
		/>
		<PageMeta meta={meta} title={title} />
		<meta content="Guillem Andreu" property="og:site_name" />
		<link href="/favicon.ico" rel="icon" sizes="48x48" type="image/x-icon" />
		<link href={iconSvg.src} rel="icon" sizes="any" type="image/svg+xml" />
		<meta content={siteMetadata.author.name} name="author" />
		<link href={new URL('/humans.txt', Astro.site)} rel="author" />
		<link href={new URL('/sitemap-index.xml', Astro.site)} rel="sitemap" />
		<meta content="nopin" name="pinterest" />
		<meta content={Astro.generator} name="generator" />
		<link blocking="render" href="#main" rel="expect" />
		<slot name="head-meta" />
		{UMAMI_ANALYTICS_HOST && UMAMI_ANALYTICS_ID && UMAMI_ANALYTICS_SCRIPT && (
			<script
				data-domains={Astro.url.host}
				data-host-url={UMAMI_ANALYTICS_HOST}
				data-website-id={UMAMI_ANALYTICS_ID}
				defer
				is:inline
				src={UMAMI_ANALYTICS_SCRIPT}
			/>
		)}
	</head>
	<body>
		<SiteHeader />
		<main class="main" id="main">
			<slot>Hello world!</slot>
		</main>
		<SiteFooter />
		<SocialIconSprite />
	</body>
</html>

<style lang="scss">
	@layer layout {
		.main {
			display: grid;
			gap: var(--layout-gap);
			grid-template-columns: repeat(13, 1fr);
			grid-template-rows: auto;
			margin-block: var(--margin-extrasmall) var(--margin-small);
			margin-inline: 0;
		}

		@media (prefers-reduced-motion: no-preference) {
			.main {
				view-transition-name: main;
			}

			::view-transition-old(main) {
				animation-name: fade-out;
			}

			::view-transition-new(main) {
				animation-name: fade-in;
			}
		}
	}
</style>
