---
import type { HTMLAttributes } from 'astro/types'

export interface PageMetadata {
	alternates?: {
		isDefault?: boolean
		lang?: HTMLAttributes<'html'>['lang']
		href: URL | string
	}[]
	canonical?: URL
	description?: string
	image?: {
		alt: string
		src: string
		height: number
		width: number
	}
	openGraph?: {
		type?: 'website' | 'article'
		title?: string
		description?: string
	}
	title?: string
}

interface Props {
	lang?: HTMLAttributes<'html'>['lang']
	meta?: PageMetadata
	title: string
}

function getUrlForAlternate(href: URL | string): URL {
	if (typeof href === 'string' && !href.startsWith('https://')) {
		return new URL(href, origin)
	}
	return new URL(href)
}

const { title, meta, lang = 'en' } = Astro.props
const metaTitle = meta?.title ?? `${title} - Guillem Andreu`
const origin = Astro.site ?? Astro.url.origin
const canonicalUrl = meta?.canonical ?? new URL(Astro.url.pathname, origin)
const defaultAlternate =
	meta?.alternates?.find((alternate) => alternate.isDefault)?.href ||
	new URL(Astro.url.pathname, origin)
---

<title>{metaTitle}</title>
<meta content={meta?.openGraph?.title ?? metaTitle} property="og:title" />
{meta?.description && <meta content={meta.description} name="description" />}
{(meta?.description || meta?.openGraph?.description) && (
	<meta
		content={meta?.openGraph?.description ?? meta.description}
		property="og:description"
	/>
)}
<link href={canonicalUrl} rel="canonical" />
<meta content={canonicalUrl} property="og:url" />
{meta?.alternates?.some((alternate) => alternate.lang !== undefined) && (
	<>
		<link
			href={getUrlForAlternate(defaultAlternate)}
			hreflang="x-default"
			rel="alternate"
		/>
		<link
			href={new URL(Astro.url.pathname, origin)}
			hreflang={lang}
			rel="alternate"
		/>
	</>
)}
{meta?.alternates?.map((alternate) =>
	alternate.lang ? (
		<link
			href={getUrlForAlternate(alternate.href)}
			hreflang={alternate.lang}
			rel="alternate"
		/>
	) : (
		<link href={getUrlForAlternate(alternate.href)} rel="alternate" />
	),
)}
<meta content={meta?.openGraph?.type ?? 'website'} property="og:type" />
{meta?.image?.src && (
	<>
		<meta content={new URL(meta.image.src, origin)} property="og:image" />
		<meta content={meta.image.alt} property="og:image:alt" />
		<meta content={meta.image.height.toString()} property="og:image:height" />
		<meta content={meta.image.width.toString()} property="og:image:width" />
	</>
)}
