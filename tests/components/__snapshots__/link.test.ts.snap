// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Link component > external link > default 1`] = `"<a aria-label="External link (opens in a new tab)" href="https://www.test.com" rel="noopener" target="_blank">External link</a>"`;

exports[`Link component > external link > with HTML content 1`] = `"<a aria-label="External link (opens in a new tab)" href="https://www.test.com" rel="noopener" target="_blank"><em>External</em> link</a>"`;

exports[`Link component > external link > with additional attributes 1`] = `"<a aria-label="External link (opens in a new tab)" href="https://www.test.com" rel="noopener" target="_blank" class="link" data-testid="test external" id="the-link">External link</a>"`;

exports[`Link component > external link > with overwritten aria-label 1`] = `"<a aria-label="Link that opens in a new tab" href="https://www.test.com" rel="noopener" target="_blank">External link</a>"`;

exports[`Link component > external link > with rel 1`] = `"<a aria-label="External link (opens in a new tab)" href="https://www.test.com" rel="nofollow noopener" target="_blank">External link</a>"`;

exports[`Link component > internal link > default 1`] = `"<a href="/test/">Internal link</a>"`;

exports[`Link component > internal link > in a new tab 1`] = `"<a aria-label="Internal link in new tab (opens in a new tab)" href="/test/" target="_blank">Internal link in new tab</a>"`;

exports[`Link component > internal link > with HTML content 1`] = `"<a href="/test/"><em>Internal</em> link</a>"`;

exports[`Link component > internal link > with additional attributes 1`] = `"<a href="/test/" class="link" data-testid="test internal" id="the-link">Internal link</a>"`;

exports[`Link component > internal link > with rel 1`] = `"<a href="/test/" rel="nofollow">Internal link</a>"`;

exports[`Link component > without href > default 1`] = `"<span>Link without href</span>"`;

exports[`Link component > without href > with HTML content 1`] = `"<span>Link <em>without href</em></span>"`;

exports[`Link component > without href > with additional attributes 1`] = `"<span class="link" data-testid="test non-href" id="the-link">Link without href</span>"`;
